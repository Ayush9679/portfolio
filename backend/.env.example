# ─── Backend Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# DO NOT commit .env to Git.
# NEVER expose this file publicly.

# ─── Application ─────────────────────────────────────────────────────────────────
APP_NAME="Ayush Kumar Dubey Portfolio API"
APP_VERSION="1.0.0"
# Set to false in production
DEBUG=false

# ─── Security ─────────────────────────────────────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_hex_string_here
ALGORITHM=HS256
# Token lifetime in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Admin Credentials ────────────────────────────────────────────────────────────
# These seed the admin user on first startup.
# Change these before deploying to production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password_here

# ─── Database ─────────────────────────────────────────────────────────────────────
# SQLite path. Use an ABSOLUTE path on VPS to ensure it is stable
# regardless of which directory uvicorn/gunicorn is started from.
# Example VPS absolute path:
#   DATABASE_URL=sqlite:////home/YOUR_LINUX_USER/portfolio/backend/data/portfolio.db
# Local development (relative path works fine):
DATABASE_URL=sqlite:///./data/portfolio.db

# ─── CORS ─────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local:
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (add your Vercel and custom domains):
#   ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app,https://www.YOUR_DOMAIN.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Primary frontend URL (used as backup if not in ALLOWED_ORIGINS list)
FRONTEND_URL=http://localhost:5173
